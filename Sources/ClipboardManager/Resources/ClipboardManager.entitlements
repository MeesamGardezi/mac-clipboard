<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      NOT sandboxed: CGEventTap (global hotkey) and CGWindowListCreateImage
      (screen capture) both require running outside the App Sandbox.
      This app must be distributed outside the Mac App Store or with a
      Hardened Runtime + entitlements for notarization.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
